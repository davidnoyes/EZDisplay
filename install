#!/bin/bash
#
# Builds EZDisplay from source and installs it.
#
# There is no binary release, so installing means archiving the Xcode project
# and exporting the result into the destination directory. Set EZDISPLAY_PATH
# to install somewhere other than /Applications.

set -u

DESTINATION="${EZDISPLAY_PATH:-/Applications}"

# Asks until the answer is recognisable. An empty answer takes `default`, so the
# capitalised letter in the prompt is what pressing Return does.
confirm() {
    local prompt="$1" default="$2" answer

    while true; do
        read -r -p "$prompt" answer
        [[ -z $answer ]] && answer="$default"

        case "$answer" in
            [Yy]*) return 0 ;;
            [Nn]*) return 1 ;;
            *)     echo "Please answer y or n." ;;
        esac
    done
}

confirm "Install EZDisplay to ${DESTINATION}? (Y/n): " y || exit 1

# A running copy keeps the old bundle open, and the export would replace the app
# underneath it.
osascript -e 'quit app "EZDisplay"' 2>/dev/null

staging=$(mktemp -d)
trap 'rm -rf "$staging"' EXIT

# Signed by the project's own certificate when there is one, and ad-hoc when
# there is not, so a fresh clone still installs with no setup. Manual style
# goes with it because the project's own is Automatic, and Automatic refuses
# any identity but ad-hoc without an Apple development team, which a
# self-signed certificate deliberately does not have. See `signing`.
IDENTITY="EZDisplay Self Signed"
EXPORT_PLIST=etc/export.plist

# Exporting re-signs, so the archive's identity is not enough on its own and
# the export has to be told the same one. Written here rather than checked in,
# because a clone with no certificate would fail on a plist that named one.
if security find-identity -v -p codesigning | grep -qF "\"$IDENTITY\""; then
    EXPORT_PLIST="${staging}/export.plist"
    cat > "$EXPORT_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>method</key>
	<string>mac-application</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>${IDENTITY}</string>
</dict>
</plist>
EOF
else
    IDENTITY="-"
fi

# xcodebuild puts its progress on stdout and its complaints on stderr. Only the
# second is worth keeping, and only if something goes wrong.
if ! log=$(xcodebuild -archivePath "${staging}/EZDisplay" \
                      -scheme EZDisplay \
                      CODE_SIGN_IDENTITY="$IDENTITY" \
                      CODE_SIGN_STYLE=Manual \
                      archive 2>&1 >/dev/null) ||
   ! log=$(xcodebuild -exportArchive \
                      -archivePath "${staging}/EZDisplay.xcarchive" \
                      -exportPath "$DESTINATION" \
                      -exportOptionsPlist "$EXPORT_PLIST" 2>&1 >/dev/null)
then
    printf 'The build failed, so nothing was installed.\n\n%s\n' "$log" >&2
    exit 100
fi

# xcodebuild reports success on the export, not on what landed, so check for the
# bundle before claiming it is installed.
if [[ ! -d ${DESTINATION}/EZDisplay.app ]]; then
    echo "The export reported success but ${DESTINATION}/EZDisplay.app is not there." >&2
    exit 100
fi

# The command line is the same binary, inside the bundle, where nothing on PATH
# can reach it. A symlink is the whole of the fix: macOS resolves the app bundle
# from the executable it actually ran rather than from the name it was called
# by, so the tool behaves identically either way. The link is named in lower
# case on purpose — matching the binary's own capitalisation would work only on
# a case-insensitive volume, and APFS can be formatted either way.
LINK=/usr/local/bin/ezdisplay
TARGET="$(cd "$DESTINATION" && pwd)/EZDisplay.app/Contents/MacOS/EZDisplay"
LINKED=$(readlink "$LINK" 2>/dev/null)

if [[ $LINKED == "$TARGET" ]]; then
    echo "The ezdisplay command is already linked."
elif [[ ( -L $LINK || -e $LINK ) && $LINKED != */EZDisplay.app/Contents/MacOS/EZDisplay ]]; then
    # Something else owns that name. Replacing it would break whatever put it
    # there, and this script has no way to know what that was.
    echo "Leaving ${LINK} alone: it is not a link to EZDisplay."
elif confirm "Add the ezdisplay command to ${LINK}? Needs an administrator password. (Y/n): " y
then
    if sudo mkdir -p "$(dirname "$LINK")" && sudo ln -sfn "$TARGET" "$LINK"; then
        echo "The ezdisplay command is on your PATH. Try: ezdisplay list"
    else
        echo "Could not create ${LINK}. The app itself is installed." >&2
    fi
fi

open "${DESTINATION}/EZDisplay.app"
echo "EZDisplay is installed in ${DESTINATION}."
