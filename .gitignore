# Build products, wherever they land.
build/
Build/
DerivedData/
*.app
*.xcarchive
*.o

# The scheme runs tests with coverage on, so a Debug binary run from here drops
# a profile in the working directory.
*.profraw

# Per-user Xcode state, which is not shared between developers.
xcuserdata/
*.xcuserdatad
*.xcscmblueprint

# The signing certificate and its private key. `signing` refuses to save one
# inside the project, so this is the second guard rather than the first.
*.p12
*.pem
*.key

# Editor and Finder litter.
*.swp
.DS_Store

# Local agent settings and throwaway probe programs.
.claude/
